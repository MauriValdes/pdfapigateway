# ================================================================
# .env.example — MS1: PDF API Gateway (solo desarrollo local)
#
# Valores de ejemplo para ejecutar localmente fuera de Docker.
# Dentro de Docker se usará http://crud-service:8000 como MS3_URL.
# ================================================================

# URL base de MS3 (PDF CRUD Service). Lleva solo la base; el código
# del gateway agrega el path /documents.
MS3_URL=http://localhost:8001

# Timeout (segundos) para llamadas a MS3. Debe ser superior al
# timeout que MS3 usa hacia MS2 (EXTRACT_SERVICE_TIMEOUT=30).
MS3_TIMEOUT=40

# Puerto interno del contenedor MS1.
APP_PORT=8000

# Puerto publicado en el host (evita colisión con MS3:8001, MS2:8002, Mongo:27018).
HOST_PORT=8003

# Nivel de logging.
LOG_LEVEL=INFO
